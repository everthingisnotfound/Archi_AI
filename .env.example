NODE_ENV=development
DATABASE_URL=postgresql://archaeologist:archaeologist@postgres:5432/archaeologist?schema=public
REDIS_URL=redis://redis:6379
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_JOB_TOKEN_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
# Alternatives: qwen/qwen3.6-27b, openai/gpt-oss-20b (may fail on some prompts)
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://localhost:8000
# In Docker Compose this is overridden to http://ai:8000 for api/worker services.
MAX_REPOSITORY_BYTES=268435456
MAX_REPOSITORY_FILES=50000
MAX_UPLOAD_BYTES=104857600
MAX_SINGLE_FILE_BYTES=10485760
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
WORKSPACE_ROOT=./data/workspaces
GITHUB_CLONE_DEPTH=1
GITHUB_CLONE_TIMEOUT_MS=120000
