NODE_ENV=development
DATABASE_URL=postgresql://archaeologist:[REDACTED]@postgres:5432/archaeologist?schema=public&connection_limit=5
REDIS_URL=redis://:redis-insecure-dev-only@redis:6379
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=[http://localhost:5173,http://localhost:8080]
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_JOB_TOKEN_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
# Alternatives: qwen/qwen3.6-27b, openai/gpt-oss-20b (may fail on some prompts)
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://localhost:8000
# In Docker Compose this is overridden to http://ai:8000 for api/worker services.
MAX_REPOSITORY_BYTES=[REDACTED]
MAX_REPOSITORY_FILES=50000
MAX_UPLOAD_BYTES=[REDACTED]
MAX_SINGLE_FILE_BYTES=10485760
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
WORKSPACE_ROOT=./data/workspaces
GITHUB_CLONE_DEPTH=1
GITHUB_CLONE_TIMEOUT_MS=120000
# Passive, same-origin website inventory limits. The crawler never logs in or submits forms.
WEBSITE_CRAWL_MAX_PAGES=40
WEBSITE_CRAWL_MAX_DEPTH=3
WEBSITE_CRAWL_MAX_ASSETS=24
WEBSITE_CRAWL_REQUEST_DELAY_MS=250
# PostgreSQL connection pooling (total connections across all services)
# With API + Worker at 5 each = 10 connections max
# For production, increase based on concurrent workload
